# =============================================================================
# Factory Time Machine - environment configuration
# =============================================================================
# Copy this file to `.env` in the project root and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is read on startup by backend/app/config.py (a small built-in loader,
# so python-dotenv is not required) and is git-ignored.
#
# NOTHING HERE IS REQUIRED. With a completely empty .env the whole application
# runs: the AI Investigator falls back to a deterministic engine that writes its
# findings from the same backend-computed evidence, and the Inspection page says
# plainly that no model is trained yet instead of inventing predictions.
# =============================================================================


# -----------------------------------------------------------------------------
# AI API (optional) - THIS IS WHERE THE API KEY BELONGS
# -----------------------------------------------------------------------------
# The LLM never computes a number. Every measurement, statistic, bottleneck rank,
# simulation result and economic figure is produced by the Python backend and
# passed to the model as structured evidence; the model only phrases it.
#
# Leave AI_API_KEY empty to run in deterministic mode (no network calls).

# Your API key. Never commit a real key; .env is git-ignored.
AI_API_KEY=

# Which provider wire format to use: `openai` (also covers anything exposing an
# OpenAI-compatible /chat/completions endpoint, such as local vLLM, Ollama's
# OpenAI shim, Azure OpenAI, OpenRouter, Together, Groq).
AI_PROVIDER=openai

# Endpoint root, without a trailing /chat/completions.
# Examples:
#   OpenAI           https://api.openai.com/v1
#   Azure OpenAI     https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   Local Ollama     http://127.0.0.1:11434/v1
#   vLLM / LM Studio http://127.0.0.1:8000/v1
AI_BASE_URL=https://api.openai.com/v1

# Model name passed straight through to the provider.
AI_MODEL=gpt-4o-mini

# Per-request timeout in seconds.
AI_TIMEOUT_SECONDS=45

# Upper bound on generated tokens per narrative. Reasoning-capable models spend
# part of this budget on hidden reasoning tokens, which can truncate the JSON
# reply. The client already retries once with double this budget when that
# happens (capped at 4000), so a slightly larger value just avoids a wasted call.
AI_MAX_OUTPUT_TOKENS=1200

# Sampling temperature. Kept low: this is reporting, not creative writing.
AI_TEMPERATURE=0.1

# Hard ceiling on AI calls per process hour. Protects your spend; once the limit
# is reached the deterministic engine answers instead.
AI_MAX_CALLS_PER_HOUR=120

# Set to true to force deterministic mode even when a key is present (useful for
# tests, demos and offline work).
AI_DISABLE=false


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Left commented out on purpose: the built-in default resolves to an absolute
# path inside data/cache/, so it does not depend on the directory you start from.
# Uncomment and repoint this at PostgreSQL to use the PostgreSQL-compatible
# schema instead, e.g. postgresql+psycopg://user:pass@localhost:5432/ftm
# DATABASE_URL=sqlite:///data/cache/factory_time_machine.sqlite3


# -----------------------------------------------------------------------------
# Analytics thresholds (tune the detective sensitivity, not the conclusions)
# -----------------------------------------------------------------------------
# Robust-z magnitude above which a single replication's station is called
# divergent. 2.5 is deliberately conservative for heavy-tailed queue columns.
DIVERGENCE_Z=2.5

# Minimum standardised effect size (Cohen's d) for a *group* contrast to count as
# a divergence. Effect size decides; statistical significance (reported
# separately as d * sqrt(n)) only gates whether a contrast is shown at all.
DIVERGENCE_EFFECT_D=0.15

# Rows sampled for population statistics and model fitting. The full Model 3
# export is 605,620 rows x 78 columns; sampling keeps start-up under ~12s.
STATS_SAMPLE_ROWS=60000

# Confidence below which an inspection result is flagged "uncertain" instead of
# being presented as a clean call.
VISION_UNCERTAINTY_THRESHOLD=0.60


# -----------------------------------------------------------------------------
# Simulation
# -----------------------------------------------------------------------------
# Horizon of the discrete-event re-simulation, in seconds. The export's Time_Now
# column is a constant 24, so this is the documented production day (86,400 s).
SIM_HORIZON_SECONDS=86400

# Fixed seed, so a scenario is reproducible and two runs are comparable.
SIM_RANDOM_SEED=20260919


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Origins allowed to call the API from a browser. The Vite dev server runs on
# 5173; the production build is served same-origin by FastAPI, which needs no
# entry here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Model artefacts (rarely changed)
# -----------------------------------------------------------------------------
# Where the trained vision checkpoint and its metrics are written, relative to
# data/cache/. These names appear in the Inspection page provenance panel.
VISION_MODEL_FILE=vision_cnn.pt
VISION_METRICS_FILE=vision_metrics.json
